{
  "name": "@inandu-solutions/grid-react",
  "version": "0.5.0",
  "description": "Standalone React data grid: sorting, free-text and per-column filtering, grouping, pagination, CSV/Excel (.xls)/PDF export and print, i18n (5 languages) and theming, with a deliberately small dependency footprint. The React port of @inandu-solutions/grid-angular.",
  "keywords": [
    "react",
    "react-grid",
    "react-datagrid",
    "react-table",
    "react-component",
    "data-grid",
    "datagrid",
    "grid",
    "table",
    "data-table",
    "virtual-scroll",
    "pagination",
    "grouping",
    "inline-editing",
    "csv-export",
    "excel-export",
    "i18n",
    "hooks",
    "headless"
  ],
  "license": "MIT",
  "author": {
    "name": "Inandu SAS",
    "url": "https://www.inandu.com/"
  },
  "homepage": "https://github.com/inandusolutions/inandu-grid-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inandusolutions/inandu-grid-react.git"
  },
  "bugs": {
    "url": "https://github.com/inandusolutions/inandu-grid-react/issues"
  },
  "type": "module",
  "main": "./dist/inandu-grid-react.cjs",
  "module": "./dist/inandu-grid-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/inandu-grid-react.js",
      "require": "./dist/inandu-grid-react.cjs"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('src/styles/inandu-grid.css','dist/style.css')\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "check:dts": "node node_modules/typescript/bin/tsc --ignoreConfig --noEmit --skipLibCheck false --strict --target es2022 --module esnext --moduleResolution bundler --jsx react-jsx dist/index.d.ts"
  },
  "peerDependencies": {
    "jspdf": "^4.2.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    }
  },
  "dependencies": {
    "@inandu-solutions/grid-core": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "jspdf": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
